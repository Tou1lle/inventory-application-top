<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> <%= locals.company.name %> </title>
</head>
<body>
  
  <%- include("partials/navigationTop") %>

  <div>
    <a href="/companies">Go back</a>
    <h1> <%= locals.company.name %> </h1>
  </div>
  <main>
    <div>
      <div>
        <img src="<%= locals.company.image_file || "https://placehold.co/600x400" %>" alt="Logo of company">
      </div>
      <div>
        <h2>About <%= locals.company.name %></h2>
        <p> <%= locals.company.info %> </p>
        <div>
          <div>
            <p>Founded Year:</p>
            <p> <%= locals.company.founded_year %> </p>
          </div>
          <div>
            <p>Country:</p>
            <p> <%= locals.company.country %> </p>
          </div>
          <div>
            <a href="<%= locals.company.website %>" target="_blank">Company Website</a>
          </div>
        </div>
      </div>
    </div>
    <div>
      <h3>Games from <%= locals.company.name %></h3>
      <% if (locals.companyGames.length === 0) { %>
        <p>No games from this company</p>
      <% } else { %>
        <ul>
          <% locals.companyGames.forEach(game => { %>
            <li>
              <div>
                <a href="/games/<%= game.id %>">Game page</a>
                <div>
                  <img src="<%= game.image_file || "https://placehold.co/300x450" %>" alt="Game poster">
                </div>
                <div>
                  <div>
                    <h2> <%= game.name %> </h2>
                    <p> <%= game.release_date %> </p>
                  </div>
                  <div>
                    <p> <%= game.description %> </p>
                  </div>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </main>

  <%- include("partials/footer") %>

</body>
</html>